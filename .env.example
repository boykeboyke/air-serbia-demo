# Air Serbia demo - environment variables
# Copy to .env (gitignored) and fill in. The demo runs WITHOUT any of these
# (flight status falls back to deterministic sample data), but to make the
# flight-status lookup a genuinely LIVE external call, set ONE of the keys below.

# Option A (recommended - HTTPS, by flight number + date):
# AeroDataBox via RapidAPI. Free tier available.
# 1. Sign up at https://rapidapi.com  2. Subscribe to "AeroDataBox"
# 3. Copy your X-RapidAPI-Key here.
AERODATABOX_KEY=

# Option B (alternative - free tier is HTTP only):
# AviationStack. Sign up at https://aviationstack.com for a free access key.
AVIATIONSTACK_KEY=

# Server port (Railway sets this automatically on deploy).
# PORT=3000

# Hybrid voice mode speech settings.
# Use provider-specific values in your private .env if you need to override defaults.
# VOICE_STT_MODEL_ID=
# VOICE_MODEL_ID=
# VOICE_OUTPUT_FORMAT=mp3_22050_32
